---
import { behaviorPath, polyfillLoaderPath, sitePath } from "../lib/path.js";

interface Props {
  title: string;
  css: string;
  modules: string[];
}

const { title, css, modules } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{title} pattern · Bootstrap HTML</title>
    <style is:inline>
      body {
        max-width: 48rem;
        margin: 2rem auto;
        padding: 0 1rem;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }

      pre {
        overflow: auto;
        padding: 1rem;
        border: 1px solid GrayText;
      }
    </style>
    <style is:inline set:html={css} />
  </head>
  <body>
    <main>
      <slot />
      <p><a href={sitePath("/patterns")}>All patterns</a></p>
    </main>
    {modules.map((name) => <script is:inline type="module" src={behaviorPath(name)}></script>)}
    <script is:inline type="module" src={polyfillLoaderPath()}></script>
  </body>
</html>

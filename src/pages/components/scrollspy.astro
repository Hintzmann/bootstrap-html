---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../lib/path.js";
import Example from "../../components/Example.astro";
import DocsMeta from "../../components/DocsMeta.astro";
import { examples, scrollspyCopy } from "../../data/examples.js";

const nestedNote = `Keep in mind that the browser picks one current scroll marker. Multiple visible targets at the same time may still look busy.`;

const nestedCode = `<div class="row">
  <div class="col-4">
    <nav id="navbar-example3" class="h-100 flex-column align-items-stretch pe-4 border-end">
      <nav class="nav nav-pills flex-column" data-polyfill-scrollspy>
        <a class="nav-link" href="#item-1">Item 1</a>
        <nav class="nav nav-pills flex-column">
          <a class="nav-link ms-3 my-1" href="#item-1-1">Item 1-1</a>
          <a class="nav-link ms-3 my-1" href="#item-1-2">Item 1-2</a>
        </nav>
        <a class="nav-link" href="#item-2">Item 2</a>
        <a class="nav-link" href="#item-3">Item 3</a>
        <nav class="nav nav-pills flex-column">
          <a class="nav-link ms-3 my-1" href="#item-3-1">Item 3-1</a>
          <a class="nav-link ms-3 my-1" href="#item-3-2">Item 3-2</a>
        </nav>
      </nav>
    </nav>
  </div>
  <div class="col-8">
    <div class="scrollspy-example-2" tabindex="0">
      <div id="item-1">
        <h4>Item 1</h4>
        <p>${scrollspyCopy}</p>
        <p>${nestedNote}</p>
      </div>
      <div id="item-1-1">
        <h5>Item 1-1</h5>
        <p>${scrollspyCopy}</p>
        <p>${nestedNote}</p>
      </div>
      <div id="item-1-2">
        <h5>Item 1-2</h5>
        <p>${scrollspyCopy}</p>
        <p>${nestedNote}</p>
      </div>
      <div id="item-2">
        <h4>Item 2</h4>
        <p>${scrollspyCopy}</p>
        <p>${nestedNote}</p>
      </div>
      <div id="item-3">
        <h4>Item 3</h4>
        <p>${scrollspyCopy}</p>
        <p>${nestedNote}</p>
      </div>
      <div id="item-3-1">
        <h5>Item 3-1</h5>
        <p>${scrollspyCopy}</p>
        <p>${nestedNote}</p>
      </div>
      <div id="item-3-2">
        <h5>Item 3-2</h5>
        <p>${scrollspyCopy}</p>

---
import { componentById } from "../data/components.js";
import { inlineMarkup } from "../lib/markup.js";
import { sitePath } from "../lib/path.js";
import { patterns } from "../lib/patterns.js";

interface Props {
  id: keyof typeof componentById;
}

const { id } = Astro.props;
const item = componentById[id];
if (!item) throw new Error(`Unknown component: ${String(id)}`);
---

<div class="mb-4">
  <table class="table table-sm mb-0">
    <caption>Markup this component accepts. The full inventory is <a href={sitePath("/components.json")}>/components.json</a>.</caption>
    <tbody>
      <tr>
        <th scope="row">Pattern</th>
        <td>
          {
            patterns[id] ? (
              <>
                <a href={sitePath(`/patterns/${id}`)}>Neutral pattern</a>
                {" without Bootstrap: markup and mechanics CSS on "}
                <code>data-pe</code>
                {" hooks."}
              </>
            ) : (
              <Fragment set:html={`None. ${inlineMarkup(item.patternless)}`} />
            )
          }
        </td>
      </tr>
      {
        item.scripts.map((script) => (
          <tr>
            <th scope="row">{script.required ? "Required" : "Optional"}</th>
            <td>
              {script.element && (
                <>
                  <code set:html={`&lt;${script.element}&gt;`} />
                  <span class="text-body-secondary"> · </span>
                </>
              )}
              <code>{script.module}</code>
              {". "}
              <Fragment set:html={inlineMarkup(script.adds)} />
            </td>
          </tr>
        ))
      }
      {
        item.avoid.length > 0 && (
          <tr>
            <th scope="row">Avoid</th>
            <td>
              <ul class="mb-0 ps-3">
                {item.avoid.map((line) => (
                  <li set:html={inlineMarkup(line)} />
                ))}
              </ul>
            </td>
          </tr>
        )
      }
    </tbody>
  </table>
</div>
